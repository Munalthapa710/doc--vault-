{
  "expo": {
    "name": "Personal Vault",
    "slug": "personal-vault-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "personalvault",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Personal Vault connects to the local development API on your Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7FAFC"
      },
      "package": "com.anonymous.personalvaultmobile"
    },
    "extra": {
      "apiUrl": ""
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
